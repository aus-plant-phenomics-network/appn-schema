# class ClassificationSeriesStructure
# based on the UML class DDICDIModels::DDICDILibrary::Classes::Representations::ClassificationSeriesStructure
cdi:ClassificationSeriesStructure
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "ClassificationSeriesStructure";
  rdfs:comment "Definition\n============\nStructure for describing the complex relationships between statistical classifications in a classification series.\n\nExamples\n==========\nA classification series that branches into separately versioned classifications.\n\nExplanatory notes\n===================\nCan use relation specification information to more fully describe the relationship between members such as parent/child, whole/part, general/specific, equivalence, etc."@en;
  
.

cdi:ClassificationSeriesStructure-identifier
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:Identifier;
.

cdi:ClassificationSeriesStructure-name
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "name";
  rdfs:comment "Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage."@en;
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:ObjectName;
.

cdi:ClassificationSeriesStructure-purpose
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "purpose";
  rdfs:comment "Intent or reason for the object/the description of the object."@en;
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:InternationalString;
.

cdi:ClassificationSeriesStructure-semantics
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "semantics";
  rdfs:comment "Specifies the semantics of the object in reference to a vocabulary, ontology, etc."@en;
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:ControlledVocabularyEntry;
.

cdi:ClassificationSeriesStructure-specification
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "specification";
  rdfs:comment "Provides information on reflexivity, transitivity, and symmetry of relationship using a descriptive term from an enumerated list. Use if all relations within this relation structure are of the same specification."@en;
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:StructureSpecification;
.

cdi:ClassificationSeriesStructure-topology
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "topology";
  rdfs:comment "Indicates the form of the associations among members of the collection. Specifies the way in which constituent parts are interrelated or arranged."@en;
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:ControlledVocabularyEntry;
.

cdi:ClassificationSeriesStructure-totality
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "totality";
  rdfs:comment "Indicates whether the related collections are comprehensive in terms of their coverage."@en;
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:StructureExtent;
.

cdi:ClassificationSeriesStructure_has_StatisticalClassificationRelationship
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_StatisticalClassificationRelationship";
  skos:altLabel "ClassificationSeriesStructure_has_StatisticalClassificationRelationship";
  
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:StatisticalClassificationRelationship;
.

cdi:ClassificationSeriesStructure_structures_ClassificationSeries
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "structures";
  skos:altLabel "ClassificationSeriesStructure_structures_ClassificationSeries";
  
  rdfs:domain cdi:ClassificationSeriesStructure;
  rdfs:range cdi:ClassificationSeries;
.

# class Code
# based on the UML class DDICDIModels::DDICDILibrary::Classes::Representations::Code
cdi:Code
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "Code";
  rdfs:comment "Definition \n============ \nThe characters used as a symbol to designate a category within a codelist or classification. (Formally, a sign for which the signifier is non-linguistic alphanumeric string.)   \n\nExamples \n========== \nThe letter M might stand for the category \"Male\" in the codeList called \"Gender\".  \n\nExplanatory notes \n=================== \nA non-linguistic alphanumeric string is one which does not correspond to a word in natural language. For use in a codelist. The representation property (value) is expressed as it would be found in a data file. Multiple representations may relate to the same category but should be expressed as separate codes.  It should not be confused with a classification item which is a placeholder for a position in a statistical classification."@en;
  
.

cdi:Code-identifier
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:Code;
  rdfs:range cdi:Identifier;
.

cdi:Code_denotes_Category
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "denotes";
  skos:altLabel "Code_denotes_Category";
  rdfs:comment "A definition for the code. Specialization of denotes for categories."@en;
  rdfs:domain cdi:Code;
  rdfs:range cdi:Category;
.

cdi:Code_uses_Notation
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "uses_Notation";
  skos:altLabel "Code_uses_Notation";
  
  rdfs:domain cdi:Code;
  rdfs:range cdi:Notation;
.

# class CodeList
# based on the UML class DDICDIModels::DDICDILibrary::Classes::Representations::CodeList
cdi:CodeList
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "CodeList";
  rdfs:comment "Definition \n============ \nList of codes and associated categories.  \n\nExamples \n========== \nThe codes \"M\" and \"F\" could point to \"Male\" and \"Female\" categories respectively.  A code list for an occupational classification system like the International Standard Classification of Occupations (ISCO-08: https://www.ilo.org/public/english/bureau/stat/isco/isco08/) could use a classification relation structure to describe a hierarchy (Chief Executives and Administrative and Commercial Managers as subtypes of Managers).   \n\nExplanatory notes \n=================== \nList may be flat or hierarchical. A hierarchical structure may have an indexed order for intended presentation even though the content within levels of the hierarchy are conceptually unordered. For hierarchical structures classification item structure is used to provide additional information on the structure and organization of the categories. Note that a category set can be structured by a classification relation structure without the need for associating any codes with the categories. This allows for the creation of a category set, for example for a response domain, without an associated codelist."@en;
  rdfs:subClassOf cdi:EnumerationDomain;
.

cdi:CodeList-allowsDuplicates
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "allowsDuplicates";
  rdfs:comment "If value is False, the members are unique within the collection - if True, there may be duplicates. (Note that a mathematical “bag” permits duplicates and is unordered - a “set” does not have duplicates and may be ordered.)"@en;
  rdfs:domain cdi:CodeList;
  rdfs:range xsd:boolean;
.

cdi:CodeList_has_Code
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_Code";
  skos:altLabel "CodeList_has_Code";
  
  rdfs:domain cdi:CodeList;
  rdfs:range cdi:Code;
.

cdi:CodeList_has_CodePosition
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_CodePosition";
  skos:altLabel "CodeList_has_CodePosition";
  
  rdfs:domain cdi:CodeList;
  rdfs:range cdi:CodePosition;
.

# class CodeListStructure
# based on the UML class DDICDIModels::DDICDILibrary::Classes::Representations::CodeListStructure
cdi:CodeListStructure
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "CodeListStructure";
  rdfs:comment "Definition\n============\nRelation structure of codes within a codelist.\n\nExplanatory notes\n===================\nAllows for the specification of complex relationships among codes. The code list structure employs a set of code relationips to describe the relationship among concepts. Each code relationship is a one to many description of connections between codes. Together they might commonly describe relationships as complex as a hierarchy."@en;
  
.

cdi:CodeListStructure-identifier
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:Identifier;
.

cdi:CodeListStructure-name
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "name";
  rdfs:comment "Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage."@en;
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:ObjectName;
.

cdi:CodeListStructure-purpose
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "purpose";
  rdfs:comment "Intent or reason for the object/the description of the object."@en;
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:InternationalString;
.

cdi:CodeListStructure-semantics
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "semantics";
  rdfs:comment "Specifies the semantics of the object in reference to a vocabulary, ontology, etc."@en;
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:ControlledVocabularyEntry;
.

cdi:CodeListStructure-specification
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "specification";
  rdfs:comment "Provides information on reflexivity, transitivity, and symmetry of relationship using a descriptive term from an enumerated list. Use if all relations within this relation structure are of the same specification."@en;
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:StructureSpecification;
.

cdi:CodeListStructure-topology
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "topology";
  rdfs:comment "Indicates the form of the associations among members of the collection. Specifies the way in which constituent parts are interrelated or arranged."@en;
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:ControlledVocabularyEntry;
.

cdi:CodeListStructure-totality
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "totality";
  rdfs:comment "Indicates whether the related collections are comprehensive in terms of their coverage."@en;
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:StructureExtent;
.

cdi:CodeListStructure_has_CodeRelationship
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_CodeRelationship";
  skos:altLabel "CodeListStructure_has_CodeRelationship";
  
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:CodeRelationship;
.

cdi:CodeListStructure_structures_CodeList
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "structures";
  skos:altLabel "CodeListStructure_structures_CodeList";
  
  rdfs:domain cdi:CodeListStructure;
  rdfs:range cdi:CodeList;
.

# class CodePosition
