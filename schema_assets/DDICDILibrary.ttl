  skos:altLabel "StatisticalClassification_has_ClassificationItem";
  
  rdfs:domain cdi:StatisticalClassification;
  rdfs:range cdi:ClassificationItem;
.

cdi:StatisticalClassification_has_ClassificationItemPosition
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_ClassificationItemPosition";
  skos:altLabel "StatisticalClassification_has_ClassificationItemPosition";
  
  rdfs:domain cdi:StatisticalClassification;
  rdfs:range cdi:ClassificationItemPosition;
.

cdi:StatisticalClassification_has_LevelStructure
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_LevelStructure";
  skos:altLabel "StatisticalClassification_has_LevelStructure";
  
  rdfs:domain cdi:StatisticalClassification;
  rdfs:range cdi:LevelStructure;
.

cdi:StatisticalClassification_isIndexedBy_ClassificationIndex
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "isIndexedBy";
  skos:altLabel "StatisticalClassification_isIndexedBy_ClassificationIndex";
  
  rdfs:domain cdi:StatisticalClassification;
  rdfs:range cdi:ClassificationIndex;
.

cdi:StatisticalClassification_isPredecessorOf_StatisticalClassification
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "isPredecessorOf";
  skos:altLabel "StatisticalClassification_isPredecessorOf_StatisticalClassification";
  rdfs:comment "Statistical classification preceded by the actual statistical classification (for those statistical classifications that are versions or updates)."@en;
  rdfs:domain cdi:StatisticalClassification;
  rdfs:range cdi:StatisticalClassification;
.

cdi:StatisticalClassification_isSuccessorOf_StatisticalClassification
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "isSuccessorOf";
  skos:altLabel "StatisticalClassification_isSuccessorOf_StatisticalClassification";
  rdfs:comment "Statistical classification preceded by the actual statistical classification (for those statistical classifications that are versions or updates)."@en;
  rdfs:domain cdi:StatisticalClassification;
  rdfs:range cdi:StatisticalClassification;
.

cdi:StatisticalClassification_isVariantOf_StatisticalClassification
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "isVariantOf";
  skos:altLabel "StatisticalClassification_isVariantOf_StatisticalClassification";
  rdfs:comment "Statistical classification on which the current variant is based, and any subsequent versions of that statistical classification to which it is also applicable."@en;
  rdfs:domain cdi:StatisticalClassification;
  rdfs:range cdi:StatisticalClassification;
.

