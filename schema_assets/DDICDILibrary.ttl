  rdfs:label "isDefinedBy_Concept";
  skos:altLabel "ClassificationFamily_isDefinedBy_Concept";
  rdfs:comment "The conceptual basis for the collection of members."@en;
  rdfs:domain cdi:ClassificationFamily;
  rdfs:range cdi:Concept;
.

cdi:ClassificationFamily_groups_ClassificationSeries
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "groups";
  skos:altLabel "ClassificationFamily_groups_ClassificationSeries";
  
  rdfs:domain cdi:ClassificationFamily;
  rdfs:range cdi:ClassificationSeries;
.

cdi:ClassificationFamily_uses_ClassificationIndex
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "uses_ClassificationIndex";
  skos:altLabel "ClassificationFamily_uses_ClassificationIndex";
  rdfs:comment "Classification indexes associated to the classification family."@en;
  rdfs:domain cdi:ClassificationFamily;
  rdfs:range cdi:ClassificationIndex;
.

# class ClassificationIndex
# based on the UML class DDICDIModels::DDICDILibrary::Classes::Representations::ClassificationIndex
cdi:ClassificationIndex
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "ClassificationIndex";
  rdfs:comment "Definition \n============ \nOrdered list of classification index entries. \n\nExamples \n========== \nAn alphabetical index of a topically ordered statistical classification.  \n\nExplanatory notes \n=================== \nA classification index shows the relationship between text found in statistical data sources (responses to survey questionnaires, administrative records) and one or more statistical classifications.  A classification index may be used to assign the codes for classification items to observations in statistical collections. Note that a GenericStatistical Information Model (GSIM) Node is the equivalent of a DDI-CDI Member, and a GSIM Node Set is a DDI-CDI Collection. A classification index can relate to one particular or to several statistical classifications. (See the GSIM Statistical Classification Model: https://statswiki.unece.org/display/gsim/Statistical+Classification+Model.)"@en;
  
.

cdi:ClassificationIndex-allowsDuplicates
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "allowsDuplicates";
  rdfs:comment "If value is False, the members are unique within the collection - if True, there may be duplicates. (Note that a mathematical “bag” permits duplicates and is unordered - a “set” does not have duplicates and may be ordered.)"@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range xsd:boolean;
.

cdi:ClassificationIndex-availableLanguage
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "availableLanguage";
  rdfs:comment "A list of languages in which the Statistical Classification is available. If a Classification Index exists in several languages, the number of entries in each language may be different, as the number of terms describing any given phenomenon can change from one language to another. However, the same phenomena should be described in each language. Supports the indication of multiple languages within a single property. Supports use of codes defined by the RFC 1766."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range xsd:language;
.

cdi:ClassificationIndex-catalogDetails
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "catalogDetails";
  rdfs:comment "Bundles the information useful for a data catalog entry. \n\nExamples would be creator, contributor, title, copyright, embargo, and license information\n\nA set of information useful for attribution, data discovery, and access.\nThis is information that is tied to the identity of the object. If this information changes the version of the associated object changes."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:CatalogDetails;
.

cdi:ClassificationIndex-codingInstruction
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "codingInstruction";
  rdfs:comment "Additional information which drives the coding process for all entries in a Classification Index."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:CommandCode;
.

cdi:ClassificationIndex-corrections
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "corrections";
  rdfs:comment "Verbal summary description of corrections, which have occurred within the Classification Index. Corrections include changing the item code associated with a classification index entry."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:InternationalString;
.

cdi:ClassificationIndex-identifier
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:Identifier;
.

cdi:ClassificationIndex-name
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "name";
  rdfs:comment "Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:ObjectName;
.

cdi:ClassificationIndex-purpose
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "purpose";
  rdfs:comment "Intent or reason for the object/the description of the object."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:InternationalString;
.

cdi:ClassificationIndex-releaseDate
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "releaseDate";
  rdfs:comment "Date when the current version of the classification index was released."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:CombinedDate;
.

cdi:ClassificationIndex_hasContact_Agent
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "hasContact";
  skos:altLabel "ClassificationIndex_hasContact_Agent";
  rdfs:comment "Person(s) who may be contacted for additional information about the classification index."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:Agent;
.

cdi:ClassificationIndex_isMaintainedBy_Agent
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "isMaintainedBy";
  skos:altLabel "ClassificationIndex_isMaintainedBy_Agent";
  rdfs:comment "The unit or group of persons within the organization responsible for the classification index (i.e., for adding, changing or deleting classification index entries)."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:Agent;
.

cdi:ClassificationIndex_isDefinedBy_Concept
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "isDefinedBy_Concept";
  skos:altLabel "ClassificationIndex_isDefinedBy_Concept";
  rdfs:comment "The conceptual basis for the collection of members."@en;
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:Concept;
.

cdi:ClassificationIndex_has_ClassificationIndexEntry
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_ClassificationIndexEntry";
  skos:altLabel "ClassificationIndex_has_ClassificationIndexEntry";
  
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:ClassificationIndexEntry;
.

cdi:ClassificationIndex_has_ClassificationIndexEntryPosition
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_ClassificationIndexEntryPosition";
  skos:altLabel "ClassificationIndex_has_ClassificationIndexEntryPosition";
  
  rdfs:domain cdi:ClassificationIndex;
  rdfs:range cdi:ClassificationIndexEntryPosition;
.

# class ClassificationIndexEntry
# based on the UML class DDICDIModels::DDICDILibrary::Classes::Representations::ClassificationIndexEntry
cdi:ClassificationIndexEntry
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "ClassificationIndexEntry";
  rdfs:comment "Definition\n============\nWord or a short phrase corresponding to a classification item in a statistical classification, together with the code of the corresponding classification item.\n\nExamples\n==========\nThe name of a locality, an economic activity, or an occupational title with the associated code from a corresponding classification item.\n\nExplanatory notes\n===================\nEach Classification Index Entry (CIE) typically corresponds to one item of a Statistical Classification (SC). Although a CIE may be associated with a Classification Item (CI) at any Level of a SC, CIEs are normally associated with items at the lowest Level.\nA CIE corresponds to a CI if the CI classifies the CIE with respect to the SC of which the CI is a member.\nCIEs typically come from responses to survey questions or are verbatim descriptions in administrative records."@en;
  
.

cdi:ClassificationIndexEntry-catalogDetails
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "catalogDetails";
  rdfs:comment "Bundles the information useful for a data catalog entry. \n\nExamples would be creator, contributor, title, copyright, embargo, and license information\n\nA set of information useful for attribution, data discovery, and access.\nThis is information that is tied to the identity of the object. If this information changes the version of the associated object changes."@en;
  rdfs:domain cdi:ClassificationIndexEntry;
  rdfs:range cdi:CatalogDetails;
.

cdi:ClassificationIndexEntry-codingInstruction
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "codingInstruction";
  rdfs:comment "Additional information which drives the coding process for the Index Entry. Required when coding is dependent upon one or many other factors."@en;
  rdfs:domain cdi:ClassificationIndexEntry;
  rdfs:range cdi:CommandCode;
.

cdi:ClassificationIndexEntry-entry
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "entry";
  rdfs:comment "Text describing the type of object/unit or object property."@en;
  rdfs:domain cdi:ClassificationIndexEntry;
  rdfs:range cdi:InternationalString;
.

cdi:ClassificationIndexEntry-identifier
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:ClassificationIndexEntry;
  rdfs:range cdi:Identifier;
.

cdi:ClassificationIndexEntry-validDates
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "validDates";
  rdfs:comment "The dates describing the validity period of the object. The date from which the object became valid must be defined if the map belongs to a \"floating\" construct. The date at which the object became invalid must be defined if the map belongs to a \"floating\" construct and is no longer valid."@en;
  rdfs:domain cdi:ClassificationIndexEntry;
  rdfs:range cdi:DateRange;
.


# class ClassificationIndexEntryPosition
# based on the UML class DDICDIModels::DDICDILibrary::Classes::Representations::ClassificationIndexEntryPosition
cdi:ClassificationIndexEntryPosition
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "ClassificationIndexEntryPosition";
  rdfs:comment "Definition \n============ \nMember indicator for use with member type classification index entry."@en;
  
.

cdi:ClassificationIndexEntryPosition-identifier
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:ClassificationIndexEntryPosition;
  rdfs:range cdi:Identifier;
.

cdi:ClassificationIndexEntryPosition-value
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "value";
  rdfs:comment "Index value of the member in an ordered array."@en;
  rdfs:domain cdi:ClassificationIndexEntryPosition;
  rdfs:range xsd:integer;
.

cdi:ClassificationIndexEntryPosition_indexes_ClassificationIndexEntry
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "indexes";
  skos:altLabel "ClassificationIndexEntryPosition_indexes_ClassificationIndexEntry";
  rdfs:comment "Restricts member target class to classification index entry."@en;
  rdfs:domain cdi:ClassificationIndexEntryPosition;
  rdfs:range cdi:ClassificationIndexEntry;
.

# class ClassificationItem
# based on the UML class DDICDIModels::DDICDILibrary::Classes::Representations::ClassificationItem
cdi:ClassificationItem
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "ClassificationItem";
  rdfs:comment "Definition \n============ \nA space for a category within a statistical classification.   \n\nExamples \n========== \nIn the 2012 North American Industry Classification System (NAICS) one classification item has the category \"construction\", and has the Code 23, which designates construction in NAICS.\n\nExplanatory notes \n=================== \nA classification item defines the content and the borders of the category. A unit can be classified to one and only one item at each level of a statistical classification. As such a classification item is a placeholder for a position in a statistical classification. It contains a designation, for which code is a common kind; a category; and possibly other things.   This differentiates it from code which is a only kind of designation, in particular if it is an alphanumeric string assigned to stand in place of a category. Statistical classifications often have multiple levels. A level is defined as a set of classification items each the same number of relationships from the top or root classification item."@en;
  
.

cdi:ClassificationItem-changeFromPreviousVersion
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "changeFromPreviousVersion";
  rdfs:comment "Describes the changes, which the item has been subject to from the previous version to the actual statistical classification."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:InternationalString;
.

cdi:ClassificationItem-changeLog
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "changeLog";
  rdfs:comment "Describes the changes, which the item has been subject to during the life time of the actual statistical classification."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:InternationalString;
.

cdi:ClassificationItem-explanatoryNotes
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "explanatoryNotes";
  rdfs:comment "A classification item may be associated with explanatory notes, which further describe and clarify the contents of the category. Explanatory notes consist of: General note: Contains either additional information about the category, or a general description of the category, which is not structured according to the \"includes\", \"includes also\", \"excludes\" pattern. Includes: Specifies the contents of the category. Includes also: A list of borderline cases, which belong to the described category. Excludes: A list of borderline cases, which do not belong to the described category. Excluded cases may contain a reference to the classification items to which the excluded cases belong."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:InternationalString;
.

cdi:ClassificationItem-futureNotes
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "futureNotes";
  rdfs:comment "The future events describe an intended or implemented change (or a number of changes) related to an invalid item (e.g., these changes may have turned the now invalid item into one or several successor items). This allows for the possibility of following successors of the item in the future."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:InternationalString;
.

cdi:ClassificationItem-identifier
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:Identifier;
.

cdi:ClassificationItem-isGenerated
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "isGenerated";
  rdfs:comment "Indicates whether or not the item has been generated to make the level to which it belongs complete."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range xsd:boolean;
.

cdi:ClassificationItem-isValid
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "isValid";
  rdfs:comment "Indicates whether or not the item is currently valid. If updates are allowed in the Statistical Classification, an item may be restricted in its validity, i.e. it may become valid or invalid after the Statistical Classification has been released."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range xsd:boolean;
.

cdi:ClassificationItem-name
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "name";
  rdfs:comment "Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage. A Classification Item has an official name as provided by the owner or maintenance unit. The name describes the content of the category. The name is unique within the Statistical Classification to which the item belongs, except for categories that are identical at more than one level in a hierarchical classification. Use the context attribute to differentiate official names or alternate names for the Classification Item."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:ObjectName;
.

cdi:ClassificationItem-validDates
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "validDates";
  rdfs:comment "The dates describing the validity period of the object. The date from which the object became valid must be defined if the map belongs to a \"floating\" construct. The date at which the object became invalid must be defined if the map belongs to a \"floating\" construct and is no longer valid."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:DateRange;
.

cdi:ClassificationItem_denotes_Category
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "denotes";
  skos:altLabel "ClassificationItem_denotes_Category";
  rdfs:comment "A definition for the code. Specialization of denotes for categories."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:Category;
.

cdi:ClassificationItem_uses_Notation
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "uses_Notation";
  skos:altLabel "ClassificationItem_uses_Notation";
  rdfs:comment "Classification item uses a notation."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:Notation;
.

cdi:ClassificationItem_excludes_ClassificationItem
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "excludes";
  skos:altLabel "ClassificationItem_excludes_ClassificationItem";
  rdfs:comment "Classification items to which the excluded cases belong (as described in explanatory notes)."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:ClassificationItem;
.

cdi:ClassificationItem_hasRulingBy_AuthorizationSource
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "hasRulingBy";
  skos:altLabel "ClassificationItem_hasRulingBy_AuthorizationSource";
  rdfs:comment "Case law rulings related to the classification item."@en;
  rdfs:domain cdi:ClassificationItem;
  rdfs:range cdi:AuthorizationSource;
.

# class ClassificationItemPosition
