cdi:CodePosition
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "CodePosition";
  rdfs:comment "Definition \n============ \nAn index within an order intended for presentation (even though the content within levels of the hierarchy may be conceptually unordered). Expressed as an integer counting upward from 01 or 1."@en;
  
.

cdi:CodePosition-identifier
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:CodePosition;
  rdfs:range cdi:Identifier;
.

cdi:CodePosition-value
