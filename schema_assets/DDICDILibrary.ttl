  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:ClassificationItemPosition;
  rdfs:range cdi:Identifier;
.

cdi:ClassificationItemPosition-value
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "value";
  rdfs:comment "Index value of the member in an ordered array."@en;
  rdfs:domain cdi:ClassificationItemPosition;
  rdfs:range xsd:integer;
.

cdi:ClassificationItemPosition_indexes_ClassificationItem
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "indexes";
  skos:altLabel "ClassificationItemPosition_indexes_ClassificationItem";
  rdfs:comment "Classification item position indexes zero to one classification items. The member containing the designation of the classification item."@en;
