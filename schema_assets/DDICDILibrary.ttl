  rdfs:label "identifier";
  rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en;
  rdfs:domain cdi:DimensionGroup;
  rdfs:range cdi:Identifier;
.

cdi:DimensionGroup-name
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "name";
  rdfs:comment "Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage."@en;
  rdfs:domain cdi:DimensionGroup;
  rdfs:range cdi:ObjectName;
.

cdi:DimensionGroup_has_DimensionComponent
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "has_DimensionComponent";
  skos:altLabel "DimensionGroup_has_DimensionComponent";
  
  rdfs:domain cdi:DimensionGroup;
  rdfs:range cdi:DimensionComponent;
.

# class QualifiedMeasure
# based on the UML class DDICDIModels::DDICDILibrary::Classes::DataDescription::Dimensional::QualifiedMeasure
cdi:QualifiedMeasure
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "QualifiedMeasure";
  rdfs:comment "Definition\n============\nA measure having a specific production method. \n\nExamples\n==========\nSeasonally adjusted monthly income."@en;
  rdfs:subClassOf cdi:MeasureComponent;
.

cdi:QualifiedMeasure_refines_MeasureComponent
