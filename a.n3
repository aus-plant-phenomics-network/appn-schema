ltu:scale_AphidLeafDamageSeverity a skos:Concept,
        schema:DefinedTerm,
        appn:Scale ;
    dcterms:description "Visual assessment of aphid leaf damage. (1) aphid damage detected on less than 5 leaves, (2) aphid damage detected on more than 5 leaves, (3) aphid damage detected and < 5 live aphid found, (4) aphid damage detected and > 5 live aphid found, (5) aphid damage detected and > 20 live aphid found, (6) Live aphid detected on inflorescences and > 50% of leaves" ;
    dcterms:title "aphid leaf damage severity" ;
    skos:inScheme ltu:cs_Scale ;
    schema:author "Ricarda Jost" ;
    schema:description "Visual assessment of aphid leaf damage. (1) aphid damage detected on less than 5 leaves, (2) aphid damage detected on more than 5 leaves, (3) aphid damage detected and < 5 live aphid found, (4) aphid damage detected and > 5 live aphid found, (5) aphid damage detected and > 20 live aphid found, (6) Live aphid detected on inflorescences and > 50% of leaves" ;
    schema:name "aphid leaf damage severity" .

ltu:scale_BotrytisCinereaInfectionSeverity a skos:Concept,
        schema:DefinedTerm,
        appn:Scale ;
    dcterms:description "Visual assessment of botrytis cinerea infection. (1) Botrytis cinerea infection detected on 1 leaf, (2) Fusarium infection detected on < 5 leaves, (3) Botrytis cinerea infection detected on > 5 leaves, (4) Botrytis cinerea infection detected on leaves and inflorescences, (5) Botrytis cinereainfection detected on inflorescences and > 50% of leaves" ;
    dcterms:title "botrytis cinerea infection severity" ;
    skos:inScheme ltu:cs_Scale ;
    schema:author "Ricarda Jost" ;
