    rdfs:comment "Time interval between successive measurements (i.e. applications) of a Scoped Measure."@en ;
    rdfs:domain cdi:ScopedMeasure ;
    rdfs:range cdi:InternationalString .

cdi:ScopedMeasure-identifier a rdf:Property,
        owl:ObjectProperty,
        ucmis:Attribute ;
    rdfs:label "identifier" ;
    rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en ;
    rdfs:domain cdi:ScopedMeasure ;
