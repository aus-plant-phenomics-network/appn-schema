cdi:ReferenceValue_correspondsTo_VariableValueComponent a rdf:Property,
        owl:ObjectProperty,
        ucmis:Association ;
    rdfs:label "correspondsTo_VariableValueComponent" ;
    rdfs:domain cdi:ReferenceValue ;
    rdfs:range cdi:VariableValueComponent ;
    skos:altLabel "ReferenceValue_correspondsTo_VariableValueComponent" .

cdi:ReferenceValue_hasValueFrom_ReferenceValueDomain a rdf:Property,
