        owl:ObjectProperty,
        ucmis:Association ;
    rdfs:label "takesValuesFrom" ;
    rdfs:comment "Points to a value domain that contains values that may be drawn from the domains of multiple simple variables."@en ;
    rdfs:domain cdi:ReferenceVariable ;
