    skos:altLabel "SentinelValueDomain_takesValuesFrom_EnumerationDomain" .

cdi:SequencePosition-identifier a rdf:Property,
        owl:ObjectProperty,
        ucmis:Attribute ;
    rdfs:label "identifier" ;
    rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en ;
    rdfs:domain cdi:SequencePosition ;
    rdfs:range cdi:Identifier .

cdi:SequencePosition-value a rdf:Property,
        owl:DatatypeProperty,
        ucmis:Attribute ;
    rdfs:label "value" ;
    rdfs:comment "Indexes the activities in a sequence using integers with a position indicated by incrementing upward from 0 or 1."@en ;
    rdfs:domain cdi:SequencePosition ;
