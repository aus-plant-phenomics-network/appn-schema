appnid:gft_Glasshouse a skos:Concept,
        schema:Enumeration,
        appn:GrowthFacilityType ;
    dcterms:description "Glasshouse facilities include naturally ventilated, air-conditioned, and evaporatively cooled glasshouses, as well as advanced research bays with automated control of lighting, fertigation, and environmental conditions, and may operate under specific containment levels (e.g., PC2) to support safe and compliant research." ;
    dcterms:title "glasshouse" ;
    skos:altLabel "controlled environment glasshouse",
        "smarthouse" ;
    skos:inScheme appnid:cs_GrowthFacilityType ;
    schema:description "Glasshouse facilities include naturally ventilated, air-conditioned, and evaporatively cooled glasshouses, as well as advanced research bays with automated control of lighting, fertigation, and environmental conditions, and may operate under specific containment levels (e.g., PC2) to support safe and compliant research." ;
    schema:name "glasshouse" .

appnid:gft_ReachInGrowthChamber a skos:Concept,
        schema:Enumeration,
        appn:GrowthFacilityType ;
    dcterms:description "Conviron reach-in cabinets are compact growth chambers that provide precise environmental control for plant and biological experiments. Available models (PCG20, PCG-Flex, ATC60, Adaptis A1000) support a range of research applications, from standard growth studies to advanced, programmable environmental simulations." ;
    dcterms:title "reach-in growth chamber" ;
    skos:altLabel "reach-in growth cabinet" ;
    skos:inScheme appnid:cs_GrowthFacilityType ;
    schema:description "Conviron reach-in cabinets are compact growth chambers that provide precise environmental control for plant and biological experiments. Available models (PCG20, PCG-Flex, ATC60, Adaptis A1000) support a range of research applications, from standard growth studies to advanced, programmable environmental simulations." ;
    schema:name "reach-in growth chamber" .

appnid:gft_Rhizolysimiter a skos:Concept,
        schema:Enumeration,
        appn:GrowthFacilityType ;
    dcterms:description "A soil–plant experimental unit used to grow plants and facilitate the observation and measurement of root development and other below-ground processes in the root zone." ;
    dcterms:title "rhizolysimiter" ;
    skos:altLabel "rhizobox",
        "rhizotube" ;
    skos:inScheme appnid:cs_GrowthFacilityType ;
    schema:description "A soil–plant experimental unit used to grow plants and facilitate the observation and measurement of root development and other below-ground processes in the root zone." ;
    schema:name "rhizolysimiter" .

appnid:gft_WalkInGrowthRoom a skos:Concept,
        schema:Enumeration,
        appn:GrowthFacilityType ;
    dcterms:description "PSI walk-in chambers (BDW40, BDW80, MTPS144) are large controlled-environment growth rooms that enable precise regulation of temperature, lighting, humidity, and atmospheric conditions. They are designed for larger-scale plant experiments, supporting reproducible research from routine studies to advanced environmental simulations." ;
    dcterms:title "walk-in growth room" ;
    skos:altLabel "Walk-in growth cabinet",
        "controlled environment room",
        "outdoor walk-in growth chamber" ;
    skos:inScheme appnid:cs_GrowthFacilityType ;
    schema:description "PSI walk-in chambers (BDW40, BDW80, MTPS144) are large controlled-environment growth rooms that enable precise regulation of temperature, lighting, humidity, and atmospheric conditions. They are designed for larger-scale plant experiments, supporting reproducible research from routine studies to advanced environmental simulations." ;
    schema:name "walk-in growth room" .

appnid:gft_WholeTreeChamber a skos:Concept,
        schema:Enumeration,
        appn:GrowthFacilityType ;
    dcterms:description "Whole tree chambers are controlled-environment systems that enclose individual trees, either potted or rooted in soil, within large structures exposed to natural sunlight. These chambers enable precise regulation of atmospheric conditions such as carbon dioxide, temperature, and humidity, while continuously measuring gas exchange between the tree canopy and the surrounding air. Designed for field-based research, they support experiments that simulate climate change conditions and allow detailed study of whole-tree responses at high temporal resolution." ;
    dcterms:title "whole tree chamber" ;
    skos:inScheme appnid:cs_GrowthFacilityType ;
    schema:description "Whole tree chambers are controlled-environment systems that enclose individual trees, either potted or rooted in soil, within large structures exposed to natural sunlight. These chambers enable precise regulation of atmospheric conditions such as carbon dioxide, temperature, and humidity, while continuously measuring gas exchange between the tree canopy and the surrounding air. Designed for field-based research, they support experiments that simulate climate change conditions and allow detailed study of whole-tree responses at high temporal resolution." ;
    schema:name "whole tree chamber" .

appnid:pt_CTScanner a skos:Concept,
        schema:Enumeration,
        appn:PlatformType ;
    dcterms:description "An image acquisition device that generates a three-dimensional image of the inside of an object from a large series of two-dimensional X-ray images taken around a single axis of rotation." ;
    dcterms:title "CT scanner" ;
    skos:altLabel "computed tomography scanner" ;
    skos:inScheme appnid:cs_PlatformType ;
    schema:description "An image acquisition device that generates a three-dimensional image of the inside of an object from a large series of two-dimensional X-ray images taken around a single axis of rotation." ;
    schema:name "CT scanner" ;
    schema:url <http://purl.obolibrary.org/obo/OBI_0000982> .

appnid:pt_UAV a skos:Concept,
        schema:Enumeration,
        appn:PlatformType ;
    dcterms:description "Unmanned aerial vehicle (UAV) is an unmanned aircraft that can be remotely controlled or operate autonomously through embedded software and onboard sensors. It encompasses both rotor types, such as quadcopters and fixed-wing designs, including hybrid vertical takeoff and landing (VTOL) drones." ;
    dcterms:title "UAV" ;
    skos:altLabel "sUAS" ;
    skos:inScheme appnid:cs_PlatformType ;
    schema:description "Unmanned aerial vehicle (UAV) is an unmanned aircraft that can be remotely controlled or operate autonomously through embedded software and onboard sensors. It encompasses both rotor types, such as quadcopters and fixed-wing designs, including hybrid vertical takeoff and landing (VTOL) drones." ;
    schema:name "UAV" ;
    schema:url <https://doi.org/10.1016/B978-0-12-817748-8.00050-X> .

