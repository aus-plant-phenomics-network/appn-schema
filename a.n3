    schema:domainIncludes schema:Event ;
    schema:isPartOf <https://pending.schema.org> ;
    schema:rangeIncludes schema:Offer ;
    schema:source <https://github.com/schemaorg/schemaorg/issues/4495> .

schema:hasStore a rdf:Property ;
    rdfs:label "hasStore" ;
    rdfs:comment "An eCommerce store part of an online marketplace." ;
