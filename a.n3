    dcterms:title "voxel" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCIT_C79424> ;
    skos:inScheme appnid:cs_Scale ;
    schema:description "The smallest distinguishable 'rectangular-parallel-piped-shaped' part of a three-dimensional space or image." ;
    schema:name "voxel" .

appnid:st_Hyperspectral a skos:Concept,
        schema:Enumeration,
        appn:SensorType ;
    dcterms:description "A digital imaging device that captures images in a large number of contiguous, narrow spectral bands across a continuous spectral range." ;
    dcterms:title "hyperspectral" ;
    skos:inScheme appnid:cs_SensorType ;
    schema:description "A digital imaging device that captures images in a large number of contiguous, narrow spectral bands across a continuous spectral range." ;
    schema:name "hyperspectral" .

appnid:st_LiDAR a skos:Concept,
        schema:Enumeration,
        appn:SensorType ;
    dcterms:description "An active remote sensing device that emits laser pulses and measures the reflected light to determine distances and generate three-dimensional spatial information." ;
    dcterms:title "LiDAR" ;
    skos:inScheme appnid:cs_SensorType ;
    schema:description "An active remote sensing device that emits laser pulses and measures the reflected light to determine distances and generate three-dimensional spatial information." ;
    schema:name "LiDAR" .

appnid:st_MultispectralCamera a skos:Concept,
        schema:Enumeration,
        appn:SensorType ;
