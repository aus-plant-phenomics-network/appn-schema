dwc: a tdwgutility:TermList ;
    rdfs:label "Core terms defined by Darwin Core"@en ;
    dc:publisher "Biodiversity Information Standards (TDWG)"@en ;
    dcterms:created "2008-11-19"^^xsd:date ;
    dcterms:description "This term list includes all currently valid terms that have been defined in the core Darwin Core namespace dwc:.  To comment on this schema, please create a new issue in https://github.com/tdwg/dwc/issues"@en ;
    dcterms:hasPart dwc:Assertion,
        dwc:Event,
        dwc:FossilSpecimen,
        dwc:GeologicalContext,
        dwc:HumanObservation,
        dwc:Identification,
        dwc:LivingSpecimen,
        dwc:MachineObservation,
        dwc:MaterialCitation,
        dwc:MaterialEntity,
        dwc:MaterialSample,
        dwc:MeasurementOrFact,
        dwc:MolecularProtocol,
        dwc:NucleotideAnalysis,
        dwc:NucleotideSequence,
        dwc:Occurrence,
        dwc:Organism,
        dwc:OrganismInteraction,
        dwc:PreservedSpecimen,
        dwc:Protocol,
        dwc:Provenance,
        dwc:ResourceRelationship,
        dwc:Taxon,
        dwc:UsagePolicy,
        dwc:acceptedNameUsage,
        dwc:acceptedNameUsageID,
        dwc:accordingTo,
        dwc:agentID,
