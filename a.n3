    rdfs:seeAlso <https://www.w3.org/TR/json-ld11/#the-rdf-json-datatype> ;
    rdfs:subClassOf rdfs:Literal .

rdf:PlainLiteral a rdfs:Datatype ;
    rdfs:label "PlainLiteral" ;
    rdfs:comment "The class of plain (i.e. untyped) literal values, as used in RIF and OWL 2" ;
    rdfs:isDefinedBy rdf: ;
    rdfs:seeAlso <http://www.w3.org/TR/rdf-plain-literal/> ;
    rdfs:subClassOf rdfs:Literal .

rdf:XMLLiteral a rdfs:Datatype ;
    rdfs:label "XMLLiteral" ;
    rdfs:comment "The datatype of XML literal values." ;
    rdfs:isDefinedBy rdf: ;
    rdfs:subClassOf rdfs:Literal .

rdf:direction a rdf:Property ;
    rdfs:label "direction" ;
    rdfs:comment "The base direction component of a CompoundLiteral." ;
    rdfs:domain rdf:CompoundLiteral ;
    rdfs:isDefinedBy rdf: ;
    rdfs:seeAlso <https://www.w3.org/TR/json-ld11/#the-rdf-compoundliteral-class-and-the-rdf-language-and-rdf-direction-properties> .

rdf:first a rdf:Property ;
    rdfs:label "first" ;
    rdfs:comment "The first item in the subject RDF list." ;
    rdfs:domain rdf:List ;
    rdfs:isDefinedBy rdf: ;
    rdfs:range rdfs:Resource .

rdf:langString a rdfs:Datatype ;
    rdfs:label "langString" ;
    rdfs:comment "The datatype of language-tagged string values" ;
    rdfs:isDefinedBy rdf: ;
    rdfs:seeAlso <http://www.w3.org/TR/rdf11-concepts/#section-Graph-Literal> ;
    rdfs:subClassOf rdfs:Literal .

rdf:language a rdf:Property ;
    rdfs:label "language" ;
    rdfs:comment "The language component of a CompoundLiteral." ;
    rdfs:domain rdf:CompoundLiteral ;
    rdfs:isDefinedBy rdf: ;
    rdfs:seeAlso <https://www.w3.org/TR/json-ld11/#the-rdf-compoundliteral-class-and-the-rdf-language-and-rdf-direction-properties> .

rdf:object a rdf:Property ;
    rdfs:label "object" ;
    rdfs:comment "The object of the subject RDF statement." ;
    rdfs:domain rdf:Statement ;
    rdfs:isDefinedBy rdf: ;
    rdfs:range rdfs:Resource .

rdf:predicate a rdf:Property ;
    rdfs:label "predicate" ;
    rdfs:comment "The predicate of the subject RDF statement." ;
    rdfs:domain rdf:Statement ;
    rdfs:isDefinedBy rdf: ;
    rdfs:range rdfs:Resource .

rdf:rest a rdf:Property ;
    rdfs:label "rest" ;
    rdfs:comment "The rest of the subject RDF list after the first item." ;
    rdfs:domain rdf:List ;
    rdfs:isDefinedBy rdf: ;
    rdfs:range rdf:List .

rdf:subject a rdf:Property ;
    rdfs:label "subject" ;
    rdfs:comment "The subject of the subject RDF statement." ;
    rdfs:domain rdf:Statement ;
    rdfs:isDefinedBy rdf: ;
    rdfs:range rdfs:Resource .

rdf:value a rdf:Property ;
    rdfs:label "value" ;
    rdfs:comment "Idiomatic property used for structured values." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdf: ;
    rdfs:range rdfs:Resource .

rdfs:comment a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "comment" ;
    rdfs:comment "A description of the subject resource.",
        ""@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs:,
        prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:range rdfs:Literal .

rdfs:isDefinedBy a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "isDefinedBy" ;
    rdfs:comment "The definition of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf rdfs:seeAlso .

rdfs:member a rdf:Property ;
    rdfs:label "member" ;
    rdfs:comment "A member of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Resource .

owl:versionInfo a owl:AnnotationProperty .

skos:altLabel a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    rdfs:comment "The range of skos:altLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "An alternative lexical label for a resource."@en ;
    skos:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)."@en .

skos:changeNote a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "change note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note about a modification to a concept."@en .

skos:definition a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "definition"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A statement or formal explanation of the meaning of a concept."@en .

skos:editorialNote a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "editorial note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note for an editor, translator or maintainer of the vocabulary."@en .

skos:exactMatch a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "has exact match"@en ;
    rdfs:comment "skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:closeMatch ;
    skos:definition "skos:exactMatch is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications. skos:exactMatch is a transitive property, and is a sub-property of skos:closeMatch."@en .

skos:example a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "example"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "An example of the use of a concept."@en .

skos:hiddenLabel a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "hidden label"@en ;
    rdfs:comment "The range of skos:hiddenLabel is the class of RDF plain literals."@en,
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations."@en .

skos:historyNote a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "history note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note about the past state/use/meaning of a concept."@en .

skos:member a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:domain skos:Collection ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( skos:Concept skos:Collection ) ] ;
    skos:definition "Relates a collection to one of its members."@en .

skos:memberList a rdf:Property,
        owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has member list"@en ;
    rdfs:comment """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@en ;
    rdfs:domain skos:OrderedCollection ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:range rdf:List ;
    skos:definition "Relates an ordered collection to the RDF list containing its members."@en .

skos:notation a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "notation"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    skos:definition "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme."@en ;
    skos:scopeNote "By convention, skos:notation is used with a typed literal in the object position of the triple."@en .

skos:prefLabel a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "preferred label"@en ;
    rdfs:comment "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en,
        "The range of skos:prefLabel is the class of RDF plain literals."@en,
        """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf rdfs:label ;
    skos:definition "The preferred lexical label for a resource, in a given language."@en .

skos:relatedMatch a rdf:Property,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has related match"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:mappingRelation,
        skos:related ;
    skos:definition "skos:relatedMatch is used to state an associative mapping link between two conceptual resources in different concept schemes."@en .

skos:scopeNote a rdf:Property,
        owl:AnnotationProperty ;
    rdfs:label "scope note"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note that helps to clarify the meaning and/or the use of a concept."@en .

prov:Accept a owl:Class ;
    rdfs:label "Accept"@en ;
    rdfs:subClassOf prov:Activity ;
    prov:definition "Activity that identifies the acceptance of a resource (e.g., an article in a conference)"@en .

prov:Copyright a owl:Class ;
    rdfs:label "Copyright"@en ;
    rdfs:subClassOf prov:Activity ;
    prov:definition "Activity that identifies the Copyrighting activity associated to a resource."@en .

prov:Create a owl:Class ;
    rdfs:label "Create"@en ;
    rdfs:subClassOf prov:Contribute ;
    prov:definition "Activity that identifies the creation of a resource"@en .

prov:Creator a owl:Class ;
    rdfs:label "Creator"@en ;
    rdfs:subClassOf prov:Contributor ;
    prov:definition "Role with the function of creating a resource. The Agent assigned to this role is associated with a Create Activity"@en .

prov:DirectQueryService a owl:Class ;
    rdfs:label "ProvenanceService" ;
    rdfs:comment "Type for a generic provenance query service. Mainly for use in RDF provenance query service descriptions, to facilitate discovery in linked data environments." ;
    rdfs:isDefinedBy prov: ;
    rdfs:subClassOf prov:SoftwareAgent ;
    prov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-query-service-discovery"^^xsd:anyURI ;
    prov:category "access-and-query" .

prov:EmptyDictionary a owl:Class ;
    rdfs:label "Empty Dictionary" ;
    rdfs:isDefinedBy prov: ;
    rdfs:subClassOf prov:Dictionary,
        prov:EmptyCollection ;
    prov:category "collections" ;
    prov:component "collections" ;
    prov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    prov:definition "An empty dictionary (i.e. has no members)." ;
    prov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-conceptual-definition"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary"^^xsd:anyURI .

prov:Modify a owl:Class ;
    rdfs:label "Modify"@en ;
    rdfs:subClassOf prov:Activity ;
    prov:definition "Activity that identifies the modification of a resource. "@en .

prov:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Agent ;
    prov:category "expanded" ;
    prov:component "agents-responsibility" ;
    prov:definition "An organization is a social or legal institution such as a company, society, etc." ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

prov:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subClassOf prov:Agent ;
    prov:category "expanded" ;
    prov:component "agents-responsibility" ;
    prov:definition "Person agents are people."@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

prov:Publish a owl:Class ;
    rdfs:label "Publish"@en ;
    rdfs:subClassOf prov:Activity ;
    prov:definition "Activity that identifies the publication of a resource"@en .

prov:Publisher a owl:Class ;
    rdfs:label "Publisher"@en ;
    rdfs:subClassOf prov:Role ;
    prov:definition "Role with the function of publishing a resource. The Agent assigned to this role is associated with a Publish Activity"@en .

prov:Replace a owl:Class ;
    rdfs:label "Replace"@en ;
    rdfs:subClassOf prov:Activity ;
    prov:definition "Activity that identifies the replacement of a resource."@en .

prov:RightsAssignment a owl:Class ;
    rdfs:label "RightsAssignment"@en ;
    rdfs:subClassOf prov:Activity ;
    prov:definition "Activity that identifies the rights assignment of a resource."@en .

prov:RightsHolder a owl:Class ;
    rdfs:label "RightsHolder"@en ;
    rdfs:subClassOf prov:Role ;
    prov:definition "Role with the function of owning or managing rights over a resource. The Agent assigned to this role is associated with a RightsAssignment Activity"@en .

prov:ServiceDescription a owl:Class ;
    rdfs:label "ServiceDescription" ;
    rdfs:comment "Type for a generic provenance query service. Mainly for use in RDF provenance query service descriptions, to facilitate discovery in linked data environments." ;
    rdfs:isDefinedBy prov: ;
    rdfs:subClassOf prov:SoftwareAgent ;
    prov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-query-service-discovery"^^xsd:anyURI ;
    prov:category "access-and-query" .

prov:Submit a owl:Class ;
    rdfs:label "Submit"@en ;
    rdfs:subClassOf prov:Activity ;
    prov:definition "Activity that identifies the issuance (e.g., publication) of a resource. "@en .

prov:activityOfInfluence rdfs:label "activityOfInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:activity .

prov:agentOfInfluence rdfs:label "agentOfInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:agent .

prov:aq a owl:AnnotationProperty ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:asInBundle a owl:ObjectProperty ;
    rdfs:label "asInBundle" ;
    rdfs:comment """prov:asInBundle is used to specify which bundle the general entity of a prov:mentionOf property is described.

When :x prov:mentionOf :y and :y is described in Bundle :b, the triple :x prov:asInBundle :b is also asserted to cite the Bundle in which :y was described."""@en ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-links#> ;
    rdfs:range prov:Bundle ;
    prov:inverse "contextOf" ;
    prov:sharesDefinitionWith prov:mentionOf .

prov:category a owl:AnnotationProperty ;
    rdfs:comment "Classify prov-o terms into three categories, including 'starting-point', 'qualifed', and 'extended'. This classification is used by the prov-o html document to gently introduce prov-o terms to its users. "@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> .

prov:component a owl:AnnotationProperty ;
    rdfs:comment "Classify prov-o terms into six components according to prov-dm, including 'agents-responsibility', 'alternate', 'annotations', 'collections', 'derivations', and 'entities-activities'. This classification is used so that readers of prov-o specification can find its correspondence with the prov-dm specification."@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> .

prov:constraints a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-CONSTRAINTS document that describes this concept."@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:contributed rdfs:label "contributed" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:wasAttributedTo .

prov:describesService a owl:ObjectProperty ;
    rdfs:label "describesService" ;
    rdfs:comment "relates a generic provenance query service resource (type prov:ServiceDescription) to a specific query service description (e.g. a prov:DirectQueryService or a sd:Service)."@en ;
    rdfs:isDefinedBy prov: ;
    prov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/rovenance-query-service-description"^^xsd:anyURI ;
    prov:category "access-and-query" ;
    prov:inverse "serviceDescribedBy" .

prov:dm a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-DM document that describes this concept."@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:editorialNote a owl:AnnotationProperty ;
    rdfs:comment "A note by the OWL development team about how this term expresses the PROV-DM concept, or how it should be used in context of semantic web or linked data."@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> .

prov:editorsDefinition a owl:AnnotationProperty ;
    rdfs:comment "When the prov-o term does not have a definition drawn from prov-dm, and the prov-o editor provides one."@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf prov:definition .

prov:ended rdfs:label "ended" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:wasEndedBy .

prov:entityOfInfluence rdfs:label "entityOfInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:entity .

prov:generalizationOf rdfs:label "generalizationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:specializationOf .

prov:generatedAsDerivation rdfs:label "generatedAsDerivation" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:hadGeneration .

prov:hadDelegate rdfs:label "hadDelegate" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:actedOnBehalfOf .

prov:hadDerivation rdfs:label "hadDerivation" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:wasDerivedFrom .

prov:hadDictionaryMember a owl:ObjectProperty ;
    rdfs:label "hadDictionaryMember" ;
    rdfs:domain prov:Dictionary ;
    rdfs:isDefinedBy prov: ;
    rdfs:range prov:KeyEntityPair ;
    prov:category "collections" ;
    prov:component "collections" ;
    prov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    prov:definition "Describes the key-entity pair that was member of a prov:Dictionary. A dictionary can have multiple members." ;
    prov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

prov:hadInfluence rdfs:label "hadInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:influencer .

prov:hadRevision rdfs:label "hadRevision" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:wasRevisionOf .

prov:has_anchor a owl:ObjectProperty ;
    rdfs:label "has_anchor" ;
    rdfs:comment "Indicates anchor URI for a potentially dynamic resource instance."@en ;
    rdfs:isDefinedBy prov: ;
    prov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#resource-represented-as-html"^^xsd:anyURI ;
    prov:category "access-and-query" ;
    prov:inverse "anchorOf" .

prov:has_provenance a owl:ObjectProperty ;
    rdfs:label "has_provenance" ;
    rdfs:comment "Indicates a provenance-URI for a resource; the resource identified by this property presents a provenance record about its subject or anchor resource."@en ;
    rdfs:isDefinedBy prov: ;
    prov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#resource-represented-as-html"^^xsd:anyURI ;
    prov:category "access-and-query" ;
    prov:inverse "provenanceOf" .

prov:has_query_service a owl:ObjectProperty ;
    rdfs:label "hasProvenanceService" ;
    rdfs:comment "Indicates a provenance query service that can access provenance related to its subject or anchor resource."@en ;
    rdfs:isDefinedBy prov: ;
    prov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/"^^xsd:anyURI ;
    prov:category "access-and-query" ;
    prov:inverse "provenanceQueryServiceOf" .

prov:informed rdfs:label "informed" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:wasInformedBy .

prov:inverse a owl:AnnotationProperty ;
    rdfs:comment "PROV-O does not define all property inverses. The directionalities defined in PROV-O should be given preference over those not defined. However, if users wish to name the inverse of a PROV-O property, the local name given by prov:inverse should be used."@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:seeAlso <http://www.w3.org/TR/prov-o/#names-of-inverse-properties> .

prov:locationOf rdfs:label "locationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:atLocation .

prov:n a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-DM document that describes this concept."@en,
        "A reference to the principal section of the PROV-M document that describes this concept."@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:order a owl:AnnotationProperty ;
    rdfs:comment "The position that this OWL term should be listed within documentation. The scope of the documentation (e.g., among all terms, among terms within a prov:category, among properties applying to a particular class, etc.) is unspecified."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:pingback a owl:ObjectProperty ;
    rdfs:label "provenance pingback" ;
    rdfs:comment "Relates a resource to a provenance pingback service that may receive additional provenance links about the resource."@en ;
    rdfs:isDefinedBy prov: ;
    prov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-pingback"^^xsd:anyURI ;
    prov:category "access-and-query" .

prov:provenanceUriTemplate a owl:DatatypeProperty ;
    rdfs:label "provenanceUriTemplate" ;
    rdfs:comment "Relates a provenance service to a URI template string for constructing provenance-URIs."@en ;
    rdfs:isDefinedBy prov: ;
    prov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/"^^xsd:anyURI ;
    prov:category "access-and-query" .

prov:qualifiedAssociationOf rdfs:label "qualifiedAssociationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedAssociation .

prov:qualifiedAttributionOf rdfs:label "qualifiedAttributionOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedAttribution .

prov:qualifiedCommunicationOf rdfs:label "qualifiedCommunicationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedCommunication .

prov:qualifiedDelegationOf rdfs:label "qualifiedDelegationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedDelegation .

prov:qualifiedDerivationOf rdfs:label "qualifiedDerivationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedDerivation .

prov:qualifiedEndOf rdfs:label "qualifiedEndOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedEnd .

prov:qualifiedForm a owl:AnnotationProperty ;
    rdfs:comment """This annotation property links a subproperty of prov:wasInfluencedBy with the subclass of prov:Influence and the qualifying property that are used to qualify it. 

Example annotation:

    prov:wasGeneratedBy prov:qualifiedForm prov:qualifiedGeneration, prov:Generation .

Then this unqualified assertion:

    :entity1 prov:wasGeneratedBy :activity1 .

can be qualified by adding:

   :entity1 prov:qualifiedGeneration :entity1Gen .
   :entity1Gen 
       a prov:Generation, prov:Influence;
       prov:activity :activity1;
       :customValue 1337 .

Note how the value of the unqualified influence (prov:wasGeneratedBy :activity1) is mirrored as the value of the prov:activity (or prov:entity, or prov:agent) property on the influence class."""@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:qualifiedGenerationOf rdfs:label "qualifiedGenerationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedGeneration .

prov:qualifiedInfluenceOf rdfs:label "qualifiedInfluenceOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedInfluence .

prov:qualifiedInsertion a owl:ObjectProperty ;
    rdfs:label "qualifiedInsertion" ;
    rdfs:domain prov:Dictionary ;
    rdfs:isDefinedBy prov: ;
    rdfs:range prov:Insertion ;
    rdfs:subPropertyOf prov:qualifiedDerivation ;
    prov:category "collections" ;
    prov:component "collections" ;
    prov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    prov:definition "The dictionary was derived from the other by insertion. prov:qualifiedInsertion shows details of the insertion, in particular the inserted key-entity pairs." ;
    prov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI .

prov:qualifiedInvalidationOf rdfs:label "qualifiedInvalidationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedInvalidation .

prov:qualifiedQuotationOf rdfs:label "qualifiedQuotationOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedQuotation .

prov:qualifiedRemoval a owl:ObjectProperty ;
    rdfs:label "qualifiedRemoval" ;
    rdfs:domain prov:Dictionary ;
    rdfs:isDefinedBy prov: ;
    rdfs:range prov:Removal ;
    rdfs:subPropertyOf prov:qualifiedDerivation ;
    prov:category "collections" ;
    prov:component "collections" ;
    prov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI ;
    prov:definition "The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed keys." ;
    prov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

prov:qualifiedSourceOf rdfs:label "qualifiedSourceOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedPrimarySource .

prov:qualifiedStartOf rdfs:label "qualifiedStartOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedStart .

prov:qualifiedUsingActivity rdfs:label "qualifiedUsingActivity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedUsage .

prov:quotedAs rdfs:label "quotedAs" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:wasQuotedFrom .

prov:revisedEntity rdfs:label "revisedEntity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:qualifiedRevision .

prov:sharesDefinitionWith a owl:AnnotationProperty ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:started rdfs:label "started" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:wasStartedBy .

prov:todo a owl:AnnotationProperty .

prov:unqualifiedForm a owl:AnnotationProperty ;
    rdfs:comment "Classes and properties used to qualify relationships are annotated with prov:unqualifiedForm to indicate the property used to assert an unqualified provenance relation."@en ;
    rdfs:isDefinedBy prov:,
        <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    prov:category "expanded" ;
    prov:component "entities-activities" ;
    prov:definition "Provides a value that is a direct representation of an entity."@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-value"^^xsd:anyURI ;
    prov:editorialNote "The editor's definition comes from http://www.w3.org/TR/rdf-primer/#rdfvalue",
        "This property serves the same purpose as rdf:value, but has been reintroduced to avoid some of the definitional ambiguity in the RDF specification (specifically, 'may be used in describing structured values')."@en .

prov:wasActivityOfInfluence rdfs:label "wasActivityOfInfluence" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:hadActivity .

prov:wasAssociateFor rdfs:label "wasAssociateFor" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:wasAssociatedWith .

prov:wasMemberOf rdfs:label "wasMemberOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:hadMember .

prov:wasPlanOf rdfs:label "wasPlanOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:hadPlan .

prov:wasPrimarySourceOf rdfs:label "wasPrimarySourceOf" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:hadPrimarySource .

prov:wasRoleIn rdfs:label "wasRoleIn" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:hadRole .

prov:wasUsedBy rdfs:label "wasUsedBy" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:used .

prov:wasUsedInDerivation rdfs:label "wasUsedInDerivation" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#> ;
    owl:inverseOf prov:hadUsage .

sosa:hasSimpleResult a owl:DatatypeProperty ;
    rdfs:label "has simple result"@en ;
    rdfs:comment "The simple value of an Observation or Actuation or act of Sampling."@en ;
    rdfs:isDefinedBy sosa: ;
    skos:definition "The simple value of an Observation or Actuation or act of Sampling."@en ;
    skos:example "For instance, the values 23 or true."@en ;
    schema:domainIncludes sosa:Actuation,
        sosa:Observation,
        sosa:Sampling .

foaf:name a owl:AnnotationProperty .

bio:additionalProperty a rdf:Property ;
    rdfs:label "additionalProperty" ;
    rdfs:comment "A property-value pair representing an additional characteristics of the entitity, e.g. a product feature or another characteristic for which there is no matching property in schema.org. Note: Publishers should be aware that applications designed to use specific schema.org properties (e.g. http://schema.org/width, http://schema.org/color, http://schema.org/gtin13, ...) will typically expect such data to be provided using those properties, rather than using the generic property/value mechanism." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/additionalProperty>,
        <https://w3id.org/bioschemas/terms/additionalProperty> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:PropertyValue ;
    schema:sameAs schema:additionalProperty .

bio:alternateScientificName a rdf:Property ;
    rdfs:label "alternateScientificName" ;
    rdfs:comment "A TaxonName representing a scientific name, with authorship and date information if known, of a synonym of the currently valid (zoological) or accepted (botanical) name." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/alternateScientificName>,
        <https://w3id.org/bioschemas/terms/alternateScientificName> ;
    schema:domainIncludes bio:Taxon ;
    schema:rangeIncludes bio:TaxonName,
        schema:Text,
        schema:URL .

bio:alternativeOf a rdf:Property ;
    rdfs:label "alternativeOf" ;
    rdfs:comment "Another gene which is a variation of this one." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/alternativeOf>,
        schema:alternativeOf,
        <https://w3id.org/bioschemas/terms/alternativeOf> ;
    schema:domainIncludes bio:Gene ;
    schema:rangeIncludes schema:Gene .

bio:associatedDisease a rdf:Property ;
    rdfs:label "associatedDisease" ;
    rdfs:comment "Disease associated to this BioChemEntity. Such a disease can be a MedicalCondition or a URL. If you want to add an evidence supporting the association, please use PropertyValue." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/associatedDisease>,
        schema:associatedDisease,
        <https://w3id.org/bioschemas/terms/associatedDisease> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes schema:MedicalCondition,
        schema:PropertyValue,
        schema:URL .

bio:bioChemInteraction a rdf:Property ;
    rdfs:label "bioChemInteraction" ;
    rdfs:comment "A BioChemEntity that is know to interact with this item." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/bioChemInteraction>,
        schema:bioChemInteraction,
        <https://w3id.org/bioschemas/terms/bioChemInteraction> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes bio:BioChemEntity .

bio:bioChemSimilarity a rdf:Property ;
    rdfs:label "bioChemSimilarity" ;
    rdfs:comment "A similar molecular entity, e.g., obtained by fingerprint similarity algorithm." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/bioChemSimilarity>,
        schema:bioChemSimilarity,
        <https://w3id.org/bioschemas/terms/bioChemSimilarity> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes bio:BioChemEntity .

bio:biologicalRole a rdf:Property ;
    rdfs:label "biologicalRole" ;
    rdfs:comment "A role played by the molecular entity within a biological context." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/biologicalRole>,
        schema:biologicalRole,
        <https://w3id.org/bioschemas/terms/biologicalRole> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes schema:DefinedTerm .

bio:chemicalComposition a rdf:Property ;
    rdfs:label "chemicalComposition" ;
    rdfs:comment "The chemical composition describes the identity and relative ratio of the chemical elements that make up the substance. For substances this often cannot be accurately determined, an approximation is acceptable." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/chemicalComposition>,
        schema:chemicalComposition,
        <https://w3id.org/bioschemas/terms/chemicalComposition> ;
    schema:domainIncludes bio:ChemicalSubstance ;
    schema:rangeIncludes schema:Text .

bio:chemicalRole a rdf:Property ;
    rdfs:label "chemicalRole" ;
    rdfs:comment "A role played by the BioChemEntity within a chemical context. A role played by the molecular entity within a chemical context." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/chemicalRole>,
        schema:chemicalRole,
        <https://w3id.org/bioschemas/terms/chemicalRole> ;
    schema:domainIncludes bio:ChemicalSubstance,
        bio:MolecularEntity ;
    schema:rangeIncludes schema:DefinedTerm .

bio:childTaxon a rdf:Property ;
    rdfs:label "childTaxon" ;
    rdfs:comment """Closest child taxa of the taxon in question.
Inverse property: parentTaxon Direct, most proximate lower-rank child taxa""" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/childTaxon>,
        schema:childTaxon,
        <https://w3id.org/bioschemas/terms/childTaxon> ;
    schema:domainIncludes bio:Taxon ;
    schema:rangeIncludes schema:Taxon,
        schema:Text,
        schema:URL .

bio:collector a rdf:Property ;
    rdfs:label "collector" ;
    rdfs:comment "The Person or Organization who collected the Sample. " ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/collector>,
        <https://w3id.org/bioschemas/terms/collector> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:Organization,
        schema:Person .

bio:custodian a rdf:Property ;
    rdfs:label "custodian" ;
    rdfs:comment "The Person or Organization who is responsible for the Sample." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/custodian>,
        <https://w3id.org/bioschemas/terms/custodian> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:Organization,
        schema:Person .

bio:dateCreated a rdf:Property ;
    rdfs:label "dateCreated" ;
    rdfs:comment "The date on which the CreativeWork was created or the item was added to a DataFeed. " ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/dateCreated>,
        <https://w3id.org/bioschemas/terms/dateCreated> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:Date ;
    schema:sameAs schema:dateCreated .

bio:defaultValue a rdf:Property ;
    rdfs:label "defaultValue" ;
    rdfs:comment "The default value for the FormalParameter. This is commonly only used for Inputs." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/defaultValue>,
        <https://w3id.org/bioschemas/terms/defaultValue> ;
    schema:domainIncludes bio:FormalParameter ;
    schema:rangeIncludes schema:Text,
        schema:Thing .

bio:documentation a rdf:Property ;
    rdfs:label "documentation" ;
    rdfs:comment "Documentation describing the ComputationalWorkflow and its use." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/documentation>,
        <https://w3id.org/bioschemas/terms/documentation> ;
    schema:domainIncludes bio:ComputationalWorkflow ;
    schema:rangeIncludes schema:CreativeWork,
        schema:URL .

bio:encodesBioChemEntity a rdf:Property ;
    rdfs:label "encodesBioChemEntity" ;
    rdfs:comment "Another BioChemEntity encoded by this one. Inverse property: isEncodedByBioChemEntity." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/encodesBioChemEntity>,
        schema:encodesBioChemEntity,
        <https://w3id.org/bioschemas/terms/encodesBioChemEntity> ;
    schema:domainIncludes bio:Gene ;
    schema:rangeIncludes schema:BioChemEntity .

bio:encodingFormat a rdf:Property ;
    rdfs:label "encodingFormat" ;
    rdfs:comment "URLs to accepted formats.  It is strongly recommented that this be specified. If it is not specified, then nothing should be assumed about the encoding formats of the FormalParameter. Recommended ontology: http://edamontology.org/format_1915" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/encodingFormat>,
        <https://w3id.org/bioschemas/terms/encodingFormat> ;
    schema:domainIncludes bio:FormalParameter ;
    schema:rangeIncludes schema:Text,
        schema:URL .

bio:expressedIn a rdf:Property ;
    rdfs:label "expressedIn" ;
    rdfs:comment "Tissue, organ, biological sample, etc in which activity of this gene has been observed experimentally. For example brain, digestive system." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/expressedIn>,
        schema:expressedIn,
        <https://w3id.org/bioschemas/terms/expressedIn> ;
    schema:domainIncludes bio:Gene ;
    schema:rangeIncludes schema:AnatomicalStructure,
        schema:AnatomicalSystem,
        schema:BioChemEntity,
        schema:DefinedTerm .

bio:funding a rdf:Property ;
    rdfs:label "funding" ;
    rdfs:comment "The funding for the workflow" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/funding>,
        <https://w3id.org/bioschemas/terms/funding> ;
    schema:domainIncludes bio:ComputationalWorkflow ;
    schema:rangeIncludes schema:Grant ;
    schema:sameAs schema:funding .

bio:gender a rdf:Property ;
    rdfs:label "gender" ;
    rdfs:comment "Gender of the person. While http://schema.org/Male and http://schema.org/Female may be used, text strings are also acceptable for people who do not identify as a binary gender" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/gender>,
        <https://w3id.org/bioschemas/terms/gender> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:GenderType,
        schema:Text ;
    schema:sameAs schema:gender .

bio:hasBioChemEntityPart a rdf:Property ;
    rdfs:label "hasBioChemEntityPart" ;
    rdfs:comment "Indicates a BioChemEntity that (in some sense) has this BioChemEntity as a part. Inverse property: isPartOfBioChemEntity" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/hasBioChemEntityPart>,
        schema:hasBioChemEntityPart,
        <https://w3id.org/bioschemas/terms/hasBioChemEntityPart> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes bio:BioChemEntity .

bio:hasBioPolymerSequence a rdf:Property ;
    rdfs:label "hasBioPolymerSequence" ;
    rdfs:comment "A symbolic representation of a BioChemEnity. For example, a nucleotide sequence of a Gene or an amino acid sequence of a Protein." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/hasBioPolymerSequence>,
        schema:hasBioPolymerSequence,
        <https://w3id.org/bioschemas/terms/hasBioPolymerSequence> ;
    schema:domainIncludes bio:Gene,
        bio:Protein ;
    schema:rangeIncludes schema:Text .

bio:hasMolecularFunction a rdf:Property ;
    rdfs:label "hasMolecularFunction" ;
    rdfs:comment "Molecular function performed by this BioChemEntity; please use PropertyValue if you want to include any evidence." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/hasMolecularFunction>,
        schema:hasMolecularFunction,
        <https://w3id.org/bioschemas/terms/hasMolecularFunction> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes schema:DefinedTerm,
        schema:PropertyValue,
        schema:URL .

bio:hasRepresentation a rdf:Property ;
    rdfs:label "hasRepresentation" ;
    rdfs:comment "A common representation such as a protein sequence or chemical structure for this entity. For images use schema.org/image." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/hasRepresentation>,
        schema:hasRepresentation,
        <https://w3id.org/bioschemas/terms/hasRepresentation> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes bio:BioChemEntity .

bio:hasStatus a rdf:Property ;
    rdfs:label "hasStatus" ;
    rdfs:comment "Schema:  One of pseudogene, dead, killed, live, predicted, suppressed." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/hasStatus>,
        <https://w3id.org/bioschemas/terms/hasStatus> ;
    schema:domainIncludes bio:Gene ;
    schema:rangeIncludes schema:Text .

bio:inChI a rdf:Property ;
    rdfs:label "inChI" ;
    rdfs:comment "Non-proprietary identifier for molecular entity that can be used in printed and electronic data sources thus enabling easier linking of diverse data compilations." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/inChI>,
        <https://w3id.org/bioschemas/terms/inChI> ;
    schema:domainIncludes bio:MolecularEntity ;
    schema:rangeIncludes schema:Text .

bio:inChIKey a rdf:Property ;
    rdfs:label "inChIKey" ;
    rdfs:comment "InChIKey is a hashed version of the full InChI (using the SHA-256 algorithm)." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/inChIKey>,
        <https://w3id.org/bioschemas/terms/inChIKey> ;
    schema:domainIncludes bio:MolecularEntity ;
    schema:rangeIncludes schema:Text .

bio:input a rdf:Property ;
    rdfs:label "input" ;
    rdfs:comment "An input required to use the computational workflow (eg. Excel spreadsheet, BAM file)" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/input>,
        <https://w3id.org/bioschemas/terms/input> ;
    schema:domainIncludes bio:ComputationalWorkflow ;
    schema:rangeIncludes bio:FormalParameter .

bio:isControl a rdf:Property ;
    rdfs:label "isControl" ;
    rdfs:comment "Indicates whether the sample is being used as a normal control, may be in combination with another sample." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/isControl>,
        <https://w3id.org/bioschemas/terms/isControl> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:Boolean .

bio:isEncodedByBioChemEntity a rdf:Property ;
    rdfs:label "isEncodedByBioChemEntity" ;
    rdfs:comment "Another BioChemEntity encoding this one. Inverse property: encodesBioChemEntity." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/isEncodedByBioChemEntity>,
        schema:isEncodedByBioChemEntity,
        <https://w3id.org/bioschemas/terms/isEncodedByBioChemEntity> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes bio:Gene .

bio:isInvolvedInBiologicalProcess a rdf:Property ;
    rdfs:label "isInvolvedInBiologicalProcess" ;
    rdfs:comment "Biological process this BioChemEntity is involved in; please use PropertyValue if you want to include any evidence." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/isInvolvedInBiologicalProcess>,
        schema:isInvolvedInBiologicalProcess,
        <https://w3id.org/bioschemas/terms/isInvolvedInBiologicalProcess> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes schema:DefinedTerm,
        schema:PropertyValue,
        schema:URL .

bio:isLocatedInSubcellularLocation a rdf:Property ;
    rdfs:label "isLocatedInSubcellularLocation" ;
    rdfs:comment "Subcellular location where this BioChemEntity is located; please use PropertyValue if you want to include any evidence." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/isLocatedInSubcellularLocation>,
        schema:isLocatedInSubcellularLocation,
        <https://w3id.org/bioschemas/terms/isLocatedInSubcellularLocation> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes schema:DefinedTerm,
        schema:PropertyValue,
        schema:URL .

bio:isPartOfBioChemEntity a rdf:Property ;
    rdfs:label "isPartOfBioChemEntity" ;
    rdfs:comment "Indicates a BioChemEntity that is (in some sense) a part of this BioChemEntity. Inverse property: hasBioChemEntityPart" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/isPartOfBioChemEntity>,
        schema:isPartOfBioChemEntity,
        <https://w3id.org/bioschemas/terms/isPartOfBioChemEntity> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes bio:BioChemEntity .

bio:itemLocation a rdf:Property ;
    rdfs:label "itemLocation" ;
    rdfs:comment "Current location of the item. " ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/itemLocation>,
        <https://w3id.org/bioschemas/terms/itemLocation> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:Place,
        schema:PostalAddress,
        schema:Text .

bio:iupacName a rdf:Property ;
    rdfs:label "iupacName" ;
    rdfs:comment "Systematic method of naming chemical compounds as recommended by the International Union of Pure and Applied Chemistry (IUPAC)." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/iupacName>,
        schema:iupacName,
        <https://w3id.org/bioschemas/terms/iupacName> ;
    schema:domainIncludes bio:MolecularEntity ;
    schema:rangeIncludes schema:Text .

bio:locationCreated a rdf:Property ;
    rdfs:label "locationCreated" ;
    rdfs:comment "The location where the CreativeWork was created, which may not be the same as the location depicted in the CreativeWork. " ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/locationCreated>,
        <https://w3id.org/bioschemas/terms/locationCreated> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:Place ;
    schema:sameAs schema:locationCreated .

bio:molecularFormula a rdf:Property ;
    rdfs:label "molecularFormula" ;
    rdfs:comment "The empirical formula is the simplest whole number ratio of all the atoms in a molecule." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/molecularFormula>,
        schema:molecularFormula,
        <https://w3id.org/bioschemas/terms/molecularFormula> ;
    schema:domainIncludes bio:MolecularEntity ;
    schema:rangeIncludes schema:Text .

bio:molecularWeight a rdf:Property ;
    rdfs:label "molecularWeight" ;
    rdfs:comment "This is the molecular weight of the entity being described, not of the parent. Units should be included in the form '<Number> <unit>', for example '12 amu' or as '<QuantitativeValue>." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/molecularWeight>,
        schema:molecularWeight,
        <https://w3id.org/bioschemas/terms/molecularWeight> ;
    schema:domainIncludes bio:MolecularEntity ;
    schema:rangeIncludes schema:QuantitativeValue,
        schema:Text .

bio:monoisotopicMolecularWeight a rdf:Property ;
    rdfs:label "monoisotopicMolecularWeight" ;
    rdfs:comment "The monoisotopic mass is the sum of the masses of the atoms in a molecule using the unbound, ground-state, rest mass of the principal (most abundant) isotope for each element instead of the isotopic average mass. Please include the units the form '<Number> <unit>', for example '770.230488 g/mol' or as '<QuantitativeValue>." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/monoisotopicMolecularWeight>,
        schema:monoisotopicMolecularWeight,
        <https://w3id.org/bioschemas/terms/monoisotopicMolecularWeight> ;
    schema:domainIncludes bio:MolecularEntity ;
    schema:rangeIncludes schema:QuantitativeValue,
        schema:Text .

bio:output a rdf:Property ;
    rdfs:label "output" ;
    rdfs:comment "An output produced by the workflow" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/output>,
        <https://w3id.org/bioschemas/terms/output> ;
    schema:domainIncludes bio:ComputationalWorkflow ;
    schema:rangeIncludes bio:FormalParameter .

bio:parentTaxon a rdf:Property ;
    rdfs:label "parentTaxon" ;
    rdfs:comment """Closest parent taxon of the taxon in question.
Inverse property: childTaxon Direct, most proximate higher-rank parent taxon""" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/parentTaxon>,
        schema:parentTaxon,
        <https://w3id.org/bioschemas/terms/parentTaxon> ;
    schema:domainIncludes bio:Taxon ;
    schema:rangeIncludes schema:Taxon,
        schema:Text,
        schema:URL .

bio:potentialUse a rdf:Property ;
    rdfs:label "potentialUse" ;
    rdfs:comment "Intended use of the BioChemEntity by humans. " ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/potentialUse>,
        schema:potentialUse,
        <https://w3id.org/bioschemas/terms/potentialUse> ;
    schema:domainIncludes bio:ChemicalSubstance,
        bio:MolecularEntity ;
    schema:rangeIncludes schema:DefinedTerm .

bio:samplingAge a rdf:Property ;
    rdfs:label "samplingAge" ;
    rdfs:comment "The age of the object when the Sample was created. " ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/samplingAge>,
        <https://w3id.org/bioschemas/terms/samplingAge> ;
    schema:domainIncludes bio:BioSample ;
    schema:rangeIncludes schema:Integer .

bio:scientificName a rdf:Property ;
    rdfs:label "scientificName" ;
    rdfs:comment "A TaxonName representing the currently valid (zoological) or accepted (botanical) name for that taxon." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/scientificName>,
        <https://w3id.org/bioschemas/terms/scientificName> ;
    schema:domainIncludes bio:Taxon ;
    schema:rangeIncludes bio:TaxonName,
        schema:Text,
        schema:URL .

bio:smiles a rdf:Property ;
    rdfs:label "smiles" ;
    rdfs:comment "A specification in form of a line notation for describing the structure of chemical species using short ASCII strings." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/smiles>,
        schema:smiles,
        <https://w3id.org/bioschemas/terms/smiles> ;
    schema:domainIncludes bio:MolecularEntity ;
    schema:rangeIncludes schema:Text .

bio:softwareRequirements a rdf:Property ;
    rdfs:label "softwareRequirements" ;
    rdfs:comment "Renaming schema.org/requirements as softwareRequirements. Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application (Examples: DirectX, Java or .NET runtime). Supersedes requirements. " ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/softwareRequirements>,
        <https://w3id.org/bioschemas/terms/softwareRequirements> ;
    schema:domainIncludes bio:ComputationalWorkflow ;
    schema:rangeIncludes schema:Text,
        schema:URL ;
    schema:sameAs schema:softwareRequirements .

bio:taxonRank a rdf:Property ;
    rdfs:label "taxonRank" ;
    rdfs:comment "The taxonomic rank of this taxon given preferably as a URI from a controlled vocabulary (e.g. the ranks from TDWG TaxonRank ontology or equivalent Wikidata URIs) " ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/taxonRank>,
        schema:taxonRank,
        <https://w3id.org/bioschemas/terms/taxonRank> ;
    schema:domainIncludes bio:Taxon,
        bio:TaxonName ;
    schema:rangeIncludes schema:PropertyValue,
        schema:Text,
        schema:URL .

bio:taxonomicRange a rdf:Property ;
    rdfs:label "taxonomicRange" ;
    rdfs:comment "The taxonomic grouping of the organism that expresses, encodes, or in someway related to the BioChemEntity." ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/taxonomicRange>,
        schema:taxonomicRange,
        <https://w3id.org/bioschemas/terms/taxonomicRange> ;
    schema:domainIncludes bio:BioChemEntity ;
    schema:rangeIncludes bio:Taxon,
        schema:DefinedTerm,
        schema:PropertyValue,
        schema:URL .

bio:valueRequired a rdf:Property ;
    rdfs:label "valueRequired" ;
    rdfs:comment "If the FormalParameter must be specified. This is commonly only used for Inputs" ;
    owl:equivalentProperty <https://discovery.biothings.io/view/bioschemastypes/valueRequired>,
        <https://w3id.org/bioschemas/terms/valueRequired> ;
    schema:domainIncludes bio:FormalParameter ;
    schema:rangeIncludes schema:Boolean .

appnid:bm_Barley a skos:Concept,
        appn:BiologicalMaterial ;
    dcterms:description "Barley, a member of the grass family, is a major cereal grain grown in temperate climates globally." ;
    dcterms:title "barley" ;
    skos:broader appnid:bm_Grain ;
    skos:exactMatch <http://purl.obolibrary.org/obo/NCBITaxon_4512>,
        <http://purl.obolibrary.org/obo/NCBITaxon_4513>,
        <https://en.wikipedia.org/wiki/Barley> ;
    skos:inScheme appnid:cs_BiologicalMaterial ;
    schema:description "Barley, a member of the grass family, is a major cereal grain grown in temperate climates globally." ;
    schema:name "barley" ;
    appn:genus "Hordeum " ;
    appn:scientificName "Hordeum vulgare" .

