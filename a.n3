cdi:Rtl a cdi:TableDirectionValues,
        cdi:TextDirectionValues ;
    rdfs:label "Rtl" ;
    rdfs:comment "Display table with first column on the right."@en,
        "Text in cells should be displayed right-to-left (rtl)."@en .

cdi:Rule-identifier a rdf:Property,
        owl:ObjectProperty,
        ucmis:Attribute ;
    rdfs:label "identifier" ;
    rdfs:comment "Identifier for objects requiring short- or long-lasting referencing and management."@en ;
    rdfs:domain cdi:Rule ;
    rdfs:range cdi:Identifier .

cdi:RuleBasedScheduling-schedulingType a rdf:Property,
        owl:ObjectProperty,
        ucmis:Attribute ;
    rdfs:label "schedulingType" ;
    rdfs:comment "Indicated if rule-based scheduling is forward-chaining or backward-chaining."@en ;
