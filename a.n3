<this:2024_Exp_3> a appn:Study ;
    schema1:affiliation <https://ror.org/01rxfrp27>,
        <https://ror.org/02zj7b759> ;
    schema1:description "Optimising N fertilizer application rates for dwarf tomato variety ‘Micro Tom’ to facilitate more uniform fruit ripening and faster cultivation cycles, using three different N levels (3, 6 and 30 mM) and a 35:65 coco coir-Perlite mix." ;
    schema1:name "Optimising N inputs for dwarf tomato cultivation in protected cropping" .

[] a owl:Axiom ;
    ppeo:hasOntologyRecommendation "http://www.cropontology.org/rdf/CO_715:0000006"^^xsd:anyURI ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource ppeo:event ;
    owl:annotatedTarget [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:anyURI xsd:string ) ] ;
            owl:onProperty ppeo:hasExternalIdentifier ] .

[] a owl:Axiom ;
    ppeo:hasOntologyRecommendation "http://purl.obolibrary.org/obo/PO_0025131"^^xsd:anyURI ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource ppeo:sample ;
    owl:annotatedTarget [ a owl:Restriction ;
            owl:onDataRange [ a rdfs:Datatype ;
                    owl:unionOf ( xsd:anyURI xsd:string ) ] ;
            owl:onProperty ppeo:hasPlantAnatomicalEntity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

[] a owl:Axiom ;
    ppeo:hasMIAPPESynonym "investigation title"@en ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource ppeo:investigation ;
    owl:annotatedTarget [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty ppeo:hasName ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

[] a owl:Axiom ;
    ppeo:hasOntologyRecommendation "http://www.cropontology.org/rdf/Variable"^^xsd:anyURI ;
