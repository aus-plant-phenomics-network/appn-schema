    dcterms:title "milliliter" ;
    skos:altLabel "ml" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/UO_0000098> ;
    skos:inScheme appnid:cs_Scale ;
    schema:description "A volume unit which is equal to one thousandth of a liter or 10^[-3] L, or to 1 cubic centimeter." ;
    schema:name "milliliter" .

