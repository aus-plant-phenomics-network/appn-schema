    skos:altLabel "mm2" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/UO_0000082> ;
    skos:inScheme appnid:cs_Scale ;
    schema:description "An area unit which is equal to one millionth of a square meter or 10^[-6] m^[2]." ;
    schema:name "square millimeter" .

