    schema:isPartOf <https://pending.schema.org> ;
    schema:rangeIncludes schema:ShippingService ;
    schema:source <https://github.com/schemaorg/schemaorg/issues/3617> .

schema:hasSponsorshipOffer a rdf:Property ;
    rdfs:label "hasSponsorshipOffer" ;
