cdi:DataPointPosition_indexes_DataPoint a rdf:Property,
        owl:ObjectProperty,
        ucmis:Association ;
    rdfs:label "indexes" ;
    rdfs:comment "Data point position indexes zero to one data point."@en ;
    rdfs:domain cdi:DataPointPosition ;
