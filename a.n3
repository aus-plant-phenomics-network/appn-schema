ltu:scale_OverallStature a skos:Concept,
        schema:DefinedTerm,
        appn:Scale ;
    dcterms:description "Visual assessment of overall stature. (1) very compact (short with short branches at steep angle), (2) compact (short with short branches at lower angle), (3) fairly compact (intermediate, short branches at steep angle), (4) lanky(ish) (tall, intermediate branch length at steep angle), (5) lanky (tall, long branches), (6) very lanky (tall, very long branches at low angle)" ;
    dcterms:title "overall stature" ;
    skos:inScheme ltu:cs_Scale ;
    schema:author "Ricarda Jost" ;
    schema:description "Visual assessment of overall stature. (1) very compact (short with short branches at steep angle), (2) compact (short with short branches at lower angle), (3) fairly compact (intermediate, short branches at steep angle), (4) lanky(ish) (tall, intermediate branch length at steep angle), (5) lanky (tall, long branches), (6) very lanky (tall, very long branches at low angle)" ;
    schema:name "overall stature" .

