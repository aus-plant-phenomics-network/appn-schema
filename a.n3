appnid:scale_Pixel a skos:Concept,
        schema:DefinedTerm,
        appn:Scale ;
    dcterms:description "A pixel (px) is the smallest addressable component of a digital image, often used as a unit of length or area in digital imaging, graphics, and web design (Wikipedia)." ;
    dcterms:title "pixel" ;
    skos:inScheme appnid:cs_Scale ;
    schema:description "A pixel (px) is the smallest addressable component of a digital image, often used as a unit of length or area in digital imaging, graphics, and web design (Wikipedia)." ;
    schema:name "pixel" .

appnid:scale_Ratio a skos:Concept,
        schema:DefinedTerm,
        appn:Scale ;
    dcterms:description "A dimensionless ratio unit which, given a pair of quantities a and b, for which b is a multiple of a, denotes b by giving the multiplier (coefficient) c for a to result in b." ;
    dcterms:title "ratio" ;
    skos:exactMatch <http://purl.obolibrary.org/obo/UO_0010006> ;
    skos:inScheme appnid:cs_Scale ;
    schema:description "A dimensionless ratio unit which, given a pair of quantities a and b, for which b is a multiple of a, denotes b by giving the multiplier (coefficient) c for a to result in b." ;
    schema:name "ratio" .

